# ─── Database ───
DB_PASSWORD=your_secure_password_here
DB_NAME=postgres

# ─── Auth ───
JWT_SECRET=your_jwt_secret_here_min_32_chars
REFRESH_SECRET=your_refresh_secret_here_min_32_chars

# ─── LLM & Embeddings ───
GEMINI_API_KEY=your_gemini_api_key
VOYAGEAI_KEY=your_voyage_api_key

# ─── Alibaba Cloud Model Studio (primary generation provider) ───
# International workspace key (prefix `sk-ws-`). Must use the dashscope-intl
# base URL; the Beijing endpoint rejects international keys outright.
ALIBABA_API_KEY=
# Override only for a mainland-China deployment (keys are region-locked).
ALIBABA_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ─── AWS Bedrock fallback (optional) ───
# Bearer token for the Bedrock OpenAI-compatible gateway. NOT a SigV4 key —
# real Bedrock uses request signing, this gateway uses a static token.
# Region is part of the credential scope.
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_BASE_URL=https://bedrock-mantle.eu-north-1.api.aws/v1

# ─── Groq Fallback (optional) ───
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# ─── Internal ───
INTERNAL_API_KEY=internal_platform_secret_key

# ─── Frontend ───
NEXT_PUBLIC_API_URL=http://your-server-ip:4000
FRONTEND_URL=http://your-server-ip:3000
